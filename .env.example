# Firebase web config (safe to expose to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend transactional email — SERVER-ONLY, never prefix with VITE_ (that would
# leak the key into the browser bundle). Read by src/lib/welcome-email.ts.
RESEND_API_KEY=
# Optional: a verified-domain sender. Defaults to Resend's shared onboarding@resend.dev,
# which only delivers to your own Resend account email until you verify a domain.
RESEND_FROM=Zennith Health <onboarding@resend.dev>

# SMS appointment reminders — SERVER-ONLY. In production set each one with
# `wrangler secret put NAME`.
# Firebase service account key (Firebase console > Project settings > Service
# accounts > Generate new private key), as the whole JSON on one line. The
# Worker has no signed-in user, so it reads and writes Firestore as this account.
FIREBASE_SERVICE_ACCOUNT=
# SMSPortal REST API credentials (SMSPortal > Settings > API Keys). While either
# is empty, reminders are only logged, not sent.
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
# Shared secret for the SMS Replies webhook (/api/sms/inbound). In SMSPortal, add
# the custom header `Authorization: Bearer <this value>` to the webhook, or
# append `?token=<this value>` to its URL.
SMSPORTAL_WEBHOOK_SECRET=
# Bearer token for POST /api/sms/reminders, which runs the reminder job on demand.
SMS_REMINDER_TRIGGER_SECRET=
