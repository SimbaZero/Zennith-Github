# Firebase web config (safe to expose to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend transactional email — SERVER-ONLY, never prefix with VITE_ (that would
# leak the key into the browser bundle). Read by src/lib/welcome-email.ts.
RESEND_API_KEY=
# Optional: a verified-domain sender. Defaults to Resend's shared onboarding@resend.dev,
# which only delivers to your own Resend account email until you verify a domain.
RESEND_FROM=Zennith Health <onboarding@resend.dev>

# SMS appointment reminders and text-message sign-in codes — SERVER-ONLY. In
# production set each one with `wrangler secret put NAME`.
# Firebase service account key (Firebase console > Project settings > Service
# accounts > Generate new private key), as the whole JSON on one line. The
# Worker has no signed-in user, so it reads and writes Firestore as this account.
FIREBASE_SERVICE_ACCOUNT=
# SMSPortal REST API credentials (SMSPortal > Settings > API Keys). While either
# is empty, reminders are only logged (a dry run), not sent or recorded, and
# patients can't choose text-message sign-in codes.
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
# Development only: "true" logs texts instead of sending them, including
# sign-in codes IN PLAIN TEXT in the server log. Never set this in production.
SMSPORTAL_TEST_MODE=
# Optional: app-wide cap on sign-in texts per 24 hours to numbers no account has
# verified yet (first-time enrolment), protecting the SMSPortal balance from
# throwaway signups. Defaults to 200. Verified patients aren't counted.
SMS_OTP_UNVERIFIED_DAILY_LIMIT=
# Shared secret for the SMS Replies webhook (/api/sms/inbound). In SMSPortal, add
# the custom header `Authorization: Bearer <this value>` to the webhook.
SMSPORTAL_WEBHOOK_SECRET=
# Bearer token for POST /api/sms/reminders, which runs the reminder job on demand.
SMS_REMINDER_TRIGGER_SECRET=
# Optional: outbound requests one reminder run may make. Defaults to 50, the
# Workers Free limit (about 23 reminders per slot); on Workers Paid set 10000.
WORKER_SUBREQUEST_LIMIT=
